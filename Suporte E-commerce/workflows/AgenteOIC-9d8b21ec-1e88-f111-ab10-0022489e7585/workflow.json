              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES(\u0027Date\u0027[Date])),\n\t\t\tAND(\u0027Date\u0027[Date] \u003E= DATE(2025, 1, 1), \u0027Date\u0027[Date] \u003C= TODAY())\n\t\t)\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t\u0027OIC\u0027,\n\t\t\t\t\u0027OIC\u0027[address1_stateorprovince],\n\t\t\t\t\u0027OIC\u0027[caseorigincodename],\n\t\t\t\t\u0027OIC\u0027[CidadeDealer],\n\t\t\t\t\u0027OIC\u0027[cnhi_businessunitidname],\n\t\t\t\t\u0027OIC\u0027[cnhi_causalsecondaryname],\n\t\t\t\t\u0027OIC\u0027[cnhi_justificativacriticidade],\n\t\t\t\t\u0027OIC\u0027[createdon],\n\t\t\t\t\u0027OIC\u0027[Dealer],\n\t\t\t\t\u0027OIC\u0027[description],\n\t\t\t\t\u0027OIC\u0027[owneridname],\n\t\t\t\t\u0027OIC\u0027[primarycontactidname],\n\t\t\t\t\u0027OIC\u0027[ticketnumber]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable)\n\t\t)\n\tVAR __DS0PrimaryWindowed = \n\t\tTOPN(\n\t\t\t501,\n\t\t\t__DS0Core,\n\t\t\t\u0027OIC\u0027[description],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[address1_stateorprovince],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[caseorigincodename],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[CidadeDealer],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[cnhi_businessunitidname],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[cnhi_causalsecondaryname],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[cnhi_justificativacriticidade],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[createdon],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[Dealer],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[owneridname],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[primarycontactidname],\n\t\t\t1,\n\t\t\t\u0027OIC\u0027[ticketnumber],\n\t\t\t1\n\t\t)\nEVALUATE\n\t__DS0PrimaryWindowed\nORDER BY\n\t\u0027OIC\u0027[description],\n\t\u0027OIC\u0027[address1_stateorprovince],\n\t\u0027OIC\u0027[caseorigincodename],\n\t\u0027OIC\u0027[CidadeDealer],\n\t\u0027OIC\u0027[cnhi_businessunitidname],\n\t\u0027OIC\u0027[cnhi_causalsecondaryname],\n\t\u0027OIC\u0027[cnhi_justificativacriticidade],\n\t\u0027OIC\u0027[createdon],\n\t\u0027OIC\u0027[Dealer],\n\t\u0027OIC\u0027[owneridname],\n\t\u0027OIC\u0027[primarycontactidname],\n\t\u0027OIC\u0027[ticketnumber]",
              "specification/serializerSettings/includeNulls": false
